{
  "name": "ez-php/testing",
  "version": "2.5.0",
  "description": "Test utilities for the ez-php framework — ApplicationTestCase, DatabaseTestCase, HttpTestCase, ModelFactory",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Andreas Uretschnig",
      "email": "andreas.uretschnig@gmail.com"
    }
  ],
  "keywords": ["testing", "test-case", "factory", "phpunit", "php", "framework", "ez-php"],
  "homepage": "https://github.com/ez-php/testing",
  "support": {
    "issues": "https://github.com/ez-php/testing/issues",
    "source": "https://github.com/ez-php/testing"
  },
  "require": {
    "php": "^8.5",
    "phpunit/phpunit": "^13.0",
    "ez-php/contracts": "^2.0",
    "ez-php/http": "^2.0",
    "ez-php/orm": "^2.0"
  },
  "suggest": {
    "ez-php/mail": "Needed for Fake\\FakeMailer",
    "ez-php/notification": "Needed for Fake\\FakeChannel",
    "ez-php/events": "Needed for Fake\\EventSpy",
    "ez-php/storage": "Needed for Fake\\FakeStorage"
  },
  "require-dev": {
    "ez-php/docker": "^2.0",
    "ez-php/mail": "^2.0",
    "ez-php/notification": "^2.0",
    "ez-php/events": "^2.0",
    "ez-php/storage": "^2.0",
    "phpstan/phpstan": "^2.1",
    "friendsofphp/php-cs-fixer": "^3.94",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpstan/phpstan-deprecation-rules": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "EzPhp\\Testing\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "cs": "php-cs-fixer fix",
    "analyse": "phpstan analyse",
    "test": "phpunit",
    "full": "composer analyse && composer cs && composer test"
  }
}
